# Generated by opentofu (modules/output-file). Do NOT edit or commit.
# Non-sensitive values that require opentofu to produce — either cloud infra
# outputs (provisioned resource names/ARNs) or values computed from user inputs
# (list indexing, string joins, concatenation) that plain YAML anchors can't do.

# ─── aggregator chart — S3 + IRSA ────────────────────────────────────────────
# S3 wiring sourced from the storage module outputs.
global:
  s3:
    region: ${cloud_storage_region}
    bucket: ${storage_bucket_public}
    forcePathStyle: false
%{ if postgres_host != "" ~}
  # Managed Postgres (RDS). Full endpoint takes precedence over the in-cluster
  # postgresService FQDN in the aggregator.postgresHost helper + keycloak KC_DB_URL.
  dataPlatform:
    postgresHost: ${postgres_host}
%{ endif ~}

%{ if postgres_host != "" ~}
# ─── common-services chart — managed Postgres (RDS) bootstrap ────────────────
# postgres.host activates the bootstrap Job; postgresBootstrap.enabled fires it.
# Together they create the dpg/aggregator roles+databases on the RDS instance.
postgres:
  host: ${postgres_host}
postgresBootstrap:
  enabled: true
%{ endif ~}

# IRSA service account annotations — pods assume the S3/SES role via SA token.
aggregator-api:
  serviceAccount:
    create: true
    annotations:
      eks.amazonaws.com/role-arn: ${app_sa_role_arn}
worker:
  serviceAccount:
    create: true
    annotations:
      eks.amazonaws.com/role-arn: ${app_sa_role_arn}

# signals s3-export subchart — SAME app_sa role and SAME public bucket as the
# aggregator worker above. There is no dedicated exporter role or export bucket
# any more, so nothing here is conditional: the app_sa role and the public
# bucket always exist. The SA name must stay in step with the exporter subject
# listed in global.service_account_subjects (iam module trust policy) — rename
# one without the other and the CronJob fails at STS assume time.
s3-export:
  serviceAccount:
    create: true
    name: signals-s3-export
    annotations:
      eks.amazonaws.com/role-arn: ${app_sa_role_arn}
  s3:
    bucket: ${storage_bucket_public}
    region: ${cloud_storage_region}

# ─── signals chart — computed config ─────────────────────────────────────────
# Values that require HCL operations plain YAML anchors can't do:
# list indexing ([0]), string join, path concatenation, and conditional output.
api:
  config:
    API_DOMAIN: https://${signals_public_hosts[0]}
    FRONTEND_BASE_URL: https://${signals_public_hosts[0]}
    # Same string as ui.hostBindings below — the UI maps host -> domain, the API
    # maps domain -> host so an email CTA reaches the recipient's own portal
    # (#569). Set it at _signals_host_bindings in global-values.yaml, never here.
    #   format: "<host>=<network>/<domain>", entries separated by ";"
    #   e.g.    "providers-signals.example.org=blue_dot/provider;seekers-signals.example.org=blue_dot/seeker"
    # Emitted unconditionally: the api chart drops empty values, so a single-host
    # release (bindings == "") falls back to FRONTEND_BASE_URL, unchanged.
    UI_HOST_BINDINGS: "${signals_host_bindings}"
    ALLOWED_ORIGINS: "${signals_allowed_origins}"
    NETWORK_CONFIG_LOCAL_FILE: "/app/schemas/${signals_network}.json"
  schemas:
    apiInternalUrl: "https://${signals_public_hosts[0]}"
    crossNetworkUrl: "https://${signals_public_hosts[0]}"
%{ if postgres_host != "" ~}
  # Managed Postgres (RDS) — overrides the in-cluster postgres.host default.
  postgres:
    host: ${postgres_host}
%{ endif ~}
%{ if signals_host_bindings != "" ~}
ui:
  hostBindings: "${signals_host_bindings}"
%{ endif ~}
%{ if postgres_host != "" ~}
# signals search subchart — managed Postgres (RDS) endpoint.
search:
  postgres:
    host: ${postgres_host}
%{ endif ~}
