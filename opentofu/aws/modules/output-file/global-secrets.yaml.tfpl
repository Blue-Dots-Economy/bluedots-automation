# Single credential file for all charts. Secrets only at ROOT level.
# Generated by opentofu (modules/output-file). Do NOT edit or commit.
# Each chart reads this same file; helm ignores keys it doesn't recognise.
#
# Two sources feed this file, and BOTH survive a regenerate:
#   - generated secrets  → the random_passwords module (kept in tfstate)
#   - hand-entered ones   → the env's gitignored `secrets.yaml`
# So edit `secrets.yaml`, not this file: anything changed here is overwritten
# on the next `apply_tf_output_file`.

# ─── common-services chart ───────────────────────────────────────────────────
credentials:
  postgresAdminPassword: "${postgres_admin_password}"
  aggregatorPassword: "${aggregator_postgres_password}"
  dpgPassword: "${signals_postgres_password}"
  signalsExportRoPassword: "${signals_export_ro_password}"
  # Keycloak's own DB role. SAME value as secrets.keycloakPostgresPassword below —
  # common-services creates/syncs the role, the keycloak release logs in with it.
  keycloakPassword: "${keycloak_postgres_password}"
  redisPassword: "${signals_redis_password}"
  postgresql:
    password: "${signals_postgres_password}"
  redis:
    password: "${signals_redis_password}"

# ─── signals s3-export subchart — read-only DB URL (signals_export_ro role) ──
s3-export:
  databaseUrl: "${signals_export_database_url}"

# ─── monitoring chart ────────────────────────────────────────────────────────
prometheus:
  grafana:
    adminPassword: "${monitoring_grafana_password}"

# Alerting secrets — deep-merged over the non-secret alerting config in
# global-values.yaml (enabled flags, smtpHost/From/Username, to).
alerting:
  email:
    smtpAuthPassword: "${smtp_password}"
  discord:
    criticalWebhook: "${discord_critical_webhook}"
    warningWebhook:  "${discord_warning_webhook}"
    infoWebhook:     "${discord_info_webhook}"

# ─── aggregator + keycloak charts ────────────────────────────────────────────
# BOTH releases read this single root `secrets:` block, which is what keeps the
# client secrets identical on the two sides: the keycloak release RENDERS the
# realm that defines these clients, the aggregator AUTHENTICATES against them.
# A per-release value here would mean the realm and the app disagree.
#
# NOTE keycloakPostgresPassword is deliberately NOT named postgresPassword —
# that key is the AGGREGATOR database password in this same block.
secrets:
  postgresPassword: "${aggregator_postgres_password}"
  redisPassword: "${signals_redis_password}"
  kcBootstrapAdminPassword: "${aggregator_kc_bootstrap_admin_password}"
  keycloakAdminClientSecret: "${aggregator_keycloak_admin_client_secret}"
  approvalTokenSecret: "${aggregator_approval_token_secret}"
  sessionKey: "${aggregator_session_key}"
  oidcClientSecret: "${aggregator_oidc_client_secret}"
  # ── keycloak release only ──────────────────────────────────────────────────
  keycloakPostgresPassword: "${keycloak_postgres_password}"
  # signals-api client secret. Also emitted as signals' KEYCLOAK_API_CLIENT_SECRET
  # below — one value, two consumers, or signals cannot obtain a token.
  signalsApiSecret: "${signals_api_client_secret}"
  # Required even while unused: the clients exist in the shared realm and
  # render-realm.sh refuses an empty client secret.
  signalstackClientSecret: "${signalstack_client_secret}"
  voiceDpgSignalsSecret: "${voice_dpg_signals_secret}"
  campaignManagerSecret: "${campaign_manager_secret}"
  signalstackAdminKey: "${signalstack_admin_key}"
  smtpUser: "${aggregator_smtp_user}"
  smtpPassword: "${smtp_password}"
  # Raya voice API key (worker -> Raya hosted API). Hand-entered in
  # <env>/secrets.yaml. Left as UPDATE_THIS_VALUE the aggregator chart treats it as
  # UNCONFIGURED and omits the Secret key entirely, so the worker boots and only
  # voice jobs fail — see helm/aggregator/templates/secrets.yaml.
  rayaApiKey: "${raya_api_key}"
  msg91AuthKey: "${msg91_auth_key}"

keycloak:
  msg91TemplateId: "${msg91_template_id}"

# ─── signals chart ───────────────────────────────────────────────────────────
api:
  secrets:
    authSecret: "${signals_auth_secret}"
    notificationSecret: "${signals_notification_secret}"
    data:
      AUTH_SECRET: "${signals_auth_secret}"
      SIGNALS_PII_KEY: "${signals_pii_key}"
      POSTGRES_PASSWORD: "${signals_postgres_password}"
      REDIS_PASSWORD: "${signals_redis_password}"
      AGGREGATOR_DPG_API_KEY: "${signalstack_admin_key}"
      NOTIFICATION_SERVICE_SECRET: "${signals_notification_secret}"
      SIGNALS_SEARCH_API_KEY: "${signals_search_api_key}"
      # raya voice bot → signals api. Seeded as a better-auth apikey row by the
      # api migrate-job (provision_service_users.sql); hand the raw value to raya
      # out of band. Separate from secrets.voiceDpgSignalsSecret above, which is
      # the same bot's Keycloak client-credentials secret.
      RAYA_VOICE_BOT_API_KEY: "${raya_voice_bot_api_key}"
      GOOGLE_GEOCODING_API_KEY: "${google_geocoding_api_key}"
      INSTANCE_SHARED_SECRET: "${signals_instance_shared_secret}"
      # MUST equal secrets.signalsApiSecret above — the keycloak release renders
      # the realm that defines the `signals-api` client with that same secret.
      KEYCLOAK_API_CLIENT_SECRET: "${signals_api_client_secret}"

ui:
  runtimeConfig:
    VITE_GOOGLE_MAPS_API_KEY: "${google_maps_api_key}"

notification-service:
  secrets:
    data:
      REDIS_PASSWORD: "${signals_redis_password}"
      GMAIL_USER: "${notification_gmail_user}"
      GMAIL_PASS: "${smtp_password}"
      MSG91_AUTH_KEY: "${msg91_auth_key}"
      MSG91_TEMPLATE_ID: "${msg91_template_id}"
  internalSecrets:
    json: |
      {
        "dpg-api-client": {
          "secret": "${signals_notification_secret}"
        }
      }

search:
  secrets:
    data:
      POSTGRES_PASSWORD: "${signals_postgres_password}"
      REDIS_PASSWORD: "${signals_redis_password}"
