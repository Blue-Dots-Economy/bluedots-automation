# Copy to helm/campaign-manager.yaml (git-ignored), fill in, then pass with -f.
# Keys not listed here keep the defaults in campaign-manager/values.yaml and
# each subchart's own values.yaml (charts/{app,raya-sync,platform-sync}/).

global:
  enabled: true
  publicHost: campaign-manager.example.com
  database:
    host: postgres.databases.svc.cluster.local
    password: database-password
  rayaApiKey: raya_xxx           # read by both app and raya-sync — set once here

app:
  image:
    repository: ghcr.io/your-org/campaign-manager
    tag: sha-1a2b3c4

  ingress:
    enabled: true
    host: campaign-manager.example.com   # TLS via letsencrypt-prod is on by default

  database:
    admin:
      password: postgres-admin-password

  # Keycloak login. APP_BASE_URL defaults to https://<ingress.host>.
  keycloak:
    baseUrl: https://auth.example.com/auth
    internalBaseUrl: http://keycloak-keycloak.common-services.svc.cluster.local:8080/auth   # optional
    realm: bluedots
    clientId: campaign-manager
  bootstrapAdminEmail: admin@example.com   # first admin, created on deploy when there is none

  secrets:
    SESSION_SECRET: random-session-secret   # generate with: openssl rand -hex 32
    CRON_SECRET: random-cron-secret
    GOOGLE_SERVICE_ACCOUNT_JSON: '{"type":"service_account","project_id":"example"}'
    KEYCLOAK_CLIENT_SECRET: keycloak-client-secret

raya-sync:
  enabled: true
  image:
    repository: ghcr.io/your-org/campaign-manager-pipeline
    tag: v1.0.0

platform-sync:
  enabled: true
  image:
    repository: ghcr.io/blue-dots-economy/adhoc-scripts/platform-sync
    tag: v1.0.0
  schedule: "0 */4 * * *"
  config:
    INSTANCE_ID: my-instance     # this deployment's Signals instance id
    EXPORT_NETWORK: purple_dot   # the Signals network this deployment reads, e.g. purple_dot or blue_dot
  secrets:
    SIGNALS_DATABASE_URL: postgresql://campaign_manager_signals_ro:xxx@host:5432/dpg
    AGG_DATABASE_URL: postgresql://aggregator_export_ro:xxx@host:5432/aggregator
