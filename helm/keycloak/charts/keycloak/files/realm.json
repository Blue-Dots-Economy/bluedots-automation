{
  "realm": "__KEYCLOAK_REALM__",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "actionTokenGeneratedByUserLifespan": 300,
  "displayName": "__BRAND_LONG_NAME__",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginTheme": "otp",
  "emailTheme": "otp",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en"
  ],
  "defaultLocale": "en",
  "attributes": {
    "phoneDefaultRegion": "IN",
    "userProfileEnabled": "true",
    "kc.user.profile.config": "{\"unmanagedAttributePolicy\":\"ENABLED\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"required\":{\"roles\":[\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"phoneNumber\",\"displayName\":\"Phone Number\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"phoneNumberVerified\",\"displayName\":\"Phone Number Verified\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
  },
  "smtpServer": {
    "host": "__SMTP_HOST__",
    "port": "__SMTP_PORT__",
    "from": "__SMTP_FROM__",
    "fromDisplayName": "__SMTP_FROM_DISPLAY__",
    "ssl": "__SMTP_SSL__",
    "starttls": "__SMTP_STARTTLS__",
    "auth": "__SMTP_AUTH__",
    "user": "__SMTP_USER__",
    "password": "__SMTP_PASSWORD__"
  },
  "authenticationFlows": [
    {
      "alias": "aggregator-otp-browser",
      "description": "Browser flow: identifier (email/phone/username) then OTP via auto-routed channel",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "aggregator-otp-forms"
        }
      ]
    },
    {
      "alias": "aggregator-otp-forms",
      "description": "Identifier resolution then OTP channel choice + verify",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "otp-identifier-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "otp-channel-choice-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-otp-choice-config"
        }
      ]
    },
    {
      "id": "9f3b1c52-7a41-4c8e-9d16-3b0f5a2e7c84",
      "alias": "aggregator-portal-browser",
      "description": "aggregator-portal only; bound by flow ID (import resolves the override by id, not alias). Adds a portal-entitlement gate to aggregator-otp-browser. Must NOT become the realm-wide browserFlow: signals-ui keeps aggregator-otp-browser.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "flowAlias": "aggregator-portal-auth"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "aggregator-portal-gate-sso-coordinator"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "flowAlias": "aggregator-portal-gate-sso-approved"
        }
      ]
    },
    {
      "alias": "aggregator-portal-auth",
      "description": "The ALTERNATIVE pair, nested one level down. Keycloak ignores every ALTERNATIVE at a level that also holds REQUIRED/CONDITIONAL executions, so the sibling gates below cannot share this level.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "aggregator-portal-otp-forms"
        }
      ]
    },
    {
      "alias": "aggregator-portal-otp-forms",
      "description": "Portal copy of aggregator-otp-forms with the entitlement gate wedged between identifier resolution and OTP dispatch, so an ineligible user never receives a code.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "otp-identifier-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 12,
          "flowAlias": "aggregator-portal-gate-otp-coordinator"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 14,
          "flowAlias": "aggregator-portal-gate-otp-approved"
        },
        {
          "authenticator": "otp-channel-choice-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-portal-otp-choice-config"
        }
      ]
    },
    {
      "alias": "aggregator-portal-gate-otp-coordinator",
      "description": "Deny before OTP dispatch: the resolved user carries no aggregator_id, so they are not a coordinator (a Signals participant, or an org owner). Runs after otp-identifier-form, which calls context.setUser().",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "aggregator-portal-cond-no-aggregator-id"
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-portal-deny-not-coordinator"
        }
      ]
    },
    {
      "alias": "aggregator-portal-gate-otp-approved",
      "description": "Deny before OTP dispatch: decision_made is absent, 'pending' or 'rejected'. Mirrors requireApproved() in apps/api/src/services/auth/access-token.ts.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "aggregator-portal-cond-not-approved"
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-portal-deny-not-approved"
        }
      ]
    },
    {
      "alias": "aggregator-portal-gate-sso-coordinator",
      "description": "Same coordinator gate on the auth-cookie path. Load-bearing in the shared realm: a Signals user with a live Keycloak SSO session skips the forms sub-flow entirely, so the pre-OTP gate never runs for them.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "aggregator-portal-cond-no-aggregator-id-sso"
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-portal-deny-not-coordinator-sso"
        }
      ]
    },
    {
      "alias": "aggregator-portal-gate-sso-approved",
      "description": "Same approval gate on the auth-cookie path.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "aggregator-portal-cond-not-approved-sso"
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "aggregator-portal-deny-not-approved-sso"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "aggregator-otp-choice-config",
      "config": {
        "otpChoice.codeLength": "6",
        "otpChoice.ttl": "300",
        "otpChoice.maxRetries": "3",
        "otpChoice.phoneAttribute": "phoneNumber"
      }
    },
    {
      "alias": "aggregator-portal-otp-choice-config",
      "config": {
        "otpChoice.codeLength": "6",
        "otpChoice.ttl": "300",
        "otpChoice.maxRetries": "3",
        "otpChoice.phoneAttribute": "phoneNumber"
      }
    },
    {
      "alias": "aggregator-portal-cond-no-aggregator-id",
      "config": {
        "attribute_name": "aggregator_id",
        "attribute_expected_value": ".+",
        "regex": "true",
        "include_group_attributes": "false",
        "not": "true"
      }
    },
    {
      "alias": "aggregator-portal-cond-no-aggregator-id-sso",
      "config": {
        "attribute_name": "aggregator_id",
        "attribute_expected_value": ".+",
        "regex": "true",
        "include_group_attributes": "false",
        "not": "true"
      }
    },
    {
      "alias": "aggregator-portal-cond-not-approved",
      "config": {
        "attribute_name": "decision_made",
        "attribute_expected_value": "approved",
        "regex": "false",
        "include_group_attributes": "false",
        "not": "true"
      }
    },
    {
      "alias": "aggregator-portal-cond-not-approved-sso",
      "config": {
        "attribute_name": "decision_made",
        "attribute_expected_value": "approved",
        "regex": "false",
        "include_group_attributes": "false",
        "not": "true"
      }
    },
    {
      "alias": "aggregator-portal-deny-not-coordinator",
      "config": {
        "denyErrorMessage": "This account does not have access to the Aggregator portal."
      }
    },
    {
      "alias": "aggregator-portal-deny-not-coordinator-sso",
      "config": {
        "denyErrorMessage": "This account does not have access to the Aggregator portal."
      }
    },
    {
      "alias": "aggregator-portal-deny-not-approved",
      "config": {
        "denyErrorMessage": "Your Aggregator registration has not been approved yet."
      }
    },
    {
      "alias": "aggregator-portal-deny-not-approved-sso",
      "config": {
        "denyErrorMessage": "Your Aggregator registration has not been approved yet."
      }
    }
  ],
